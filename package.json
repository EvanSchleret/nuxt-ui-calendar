{
  "name": "@evanschleret/nuxt-ui-calendar",
  "version": "0.1.0",
  "author": "@evanschleret",
  "description": "A reusable Nuxt UI calendar module with day, week and month views.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanschleret/nuxt-ui-calendar.git"
  },
  "type": "module",
  "main": "./dist/module.cjs",
  "module": "./dist/module.mjs",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    },
    "./runtime/types": {
      "types": "./dist/runtime/types.d.ts",
      "import": "./dist/runtime/types.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "playground": "nuxt dev playground",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "@internationalized/date": "^3.12.4",
    "date-fns": "^4.4.0"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.12.0",
    "nuxt": ">=4.0.0"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.2",
    "typescript": "^6.0.3",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/eslint": "^1.15.2",
    "@types/bun": "latest",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "unbuild": "^3.6.1",
    "vue-tsc": "^3.3.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "bun@1.4.3"
}
